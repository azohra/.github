{
  "title": {
    "path": ".github/workflows/conventional-pr.yml",
    "workflow": {
      "on": {
        "pull_request_target": {
          "types": [
            "opened",
            "reopened",
            "edited",
            "synchronize"
          ]
        }
      },
      "permissions": {
        "pull-requests": "write"
      },
      "jobs": {
        "title": {
          "uses": "azohra/.github/.github/workflows/title.yml@main"
        }
      }
    }
  },
  "dependabot-merge": {
    "path": ".github/workflows/dependabot-merge.yml",
    "workflow": {
      "on": {
        "pull_request_target": {
          "types": [
            "opened",
            "reopened",
            "synchronize"
          ]
        }
      },
      "permissions": {
        "contents": "read",
        "pull-requests": "read"
      },
      "jobs": {
        "merge": {
          "uses": "azohra/.github/.github/workflows/dependabot-merge.yml@main",
          "secrets": {
            "BOSUN_PRIVATE_KEY": "${{ secrets.BOSUN_PRIVATE_KEY }}"
          }
        }
      }
    }
  }
}
